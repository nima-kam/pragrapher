PARAGRAPHER_ENV=development
SECRET_KEY=
DATABASE_URL=postgresql+psycopg:///paragrapher
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEMO_CREDITS_ENABLED=true
MAIL_MODE=console
# Optional SMTP delivery. Leave blank for the local outbox/console mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Paragrapher <noreply@example.test>
